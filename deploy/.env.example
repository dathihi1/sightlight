# .env.example — SignLight (UAT)
# Sao chép thành .env và điền giá trị thật. KHÔNG commit .env.
# Mọi giá trị "change_me" PHẢI được thay bằng chuỗi ngẫu nhiên đủ mạnh trước khi chạy.

# ---------- Cơ sở dữ liệu ----------
DB_USER=signlight
DB_PASSWORD=change_me
DB_NAME=signlight_uat

# ---------- Cache ----------
REDIS_PASSWORD=change_me

# ---------- Lưu trữ đối tượng (MinIO ở UAT) ----------
STORAGE_ACCESS_KEY=change_me
STORAGE_SECRET_KEY=change_me
STORAGE_BUCKET_VIDEO=signlight-video
STORAGE_BUCKET_MEDIA=signlight-media
STORAGE_SIGNED_URL_TTL_SECONDS=900

# ---------- Bảo mật / JWT ----------
# Khoá ký JWT: chuỗi ngẫu nhiên >= 64 ký tự. Sinh bằng: openssl rand -base64 64
JWT_SECRET=change_me
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
# Salt riêng dùng để băm IP trong login_history (NFR-13)
IP_HASH_SALT=change_me

# ---------- URL công khai (dùng lúc build frontend) ----------
PUBLIC_API_BASE_URL=http://<HOST>:18080
PUBLIC_CDN_BASE_URL=http://<HOST>:18082
PUBLIC_WEB_BASE_URL=http://<HOST>:18081

# ---------- Google OAuth2 (FR-03) ----------
GOOGLE_CLIENT_ID=change_me
GOOGLE_CLIENT_SECRET=change_me


# ---------- Email giao dịch (FR-39) ----------
MAIL_PROVIDER_API_KEY=change_me
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=SignLight

# ---------- Chuyển mã video (FR-33) ----------
TRANSCODE_WEBHOOK_SECRET=change_me

# ---------- Nhận dạng ký hiệu (FR-18) ----------
# Danh sách phiên bản mô hình được chấp nhận, phân tách bằng dấu phẩy.
FINGERSPELL_SUPPORTED_MODEL_VERSIONS=fs-v1.2.0

# ---------- 🤖 Dịch vụ AI nhận diện ký hiệu động (FR-41→44) ----------
# Dịch vụ AI chạy nội bộ, KHÔNG expose ra Internet (ADR-10).
SIGNLIGHT_AI_BASE_URL=http://ai:7860
SIGNLIGHT_AI_TIMEOUT_MS=5000
SIGNLIGHT_AI_MODEL_VERSION=vsl-mvp30-v2-lite-transformer
# Ngưỡng chấm — PHẢI hiệu chỉnh lại sau khi đo trên webcam thật (BRD R-02, NFR-19)
SIGNLIGHT_AI_CONFIDENCE_THRESHOLD=0.55
SIGNLIGHT_AI_CONFIDENCE_MARGIN=0.03
# Hạn mức lượt thử/ngày cho người dùng miễn phí (FR-30)
SIGNLIGHT_AI_FREE_DAILY_QUOTA=5
# Bucket RIÊNG cho dữ liệu góp tự nguyện (FR-46) — quyền truy cập tách biệt
STORAGE_BUCKET_DONATION=signlight-donation
DONATION_RETENTION_MONTHS=24

# ---------- Thanh toán VNPay (FR-29, FR-32) ----------
# LƯU Ý: vnp_Amount = số tiền VND × 100
VNPAY_TMN_CODE=change_me
VNPAY_HASH_SECRET=change_me
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=http://<HOST>:18081/billing/return/vnpay
VNPAY_IPN_URL=http://<HOST>:18080/api/v1/billing/ipn/vnpay

# ---------- Thanh toán MoMo (FR-29, FR-32) ----------
MOMO_PARTNER_CODE=change_me
MOMO_ACCESS_KEY=change_me
MOMO_SECRET_KEY=change_me
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_RETURN_URL=http://<HOST>:18081/billing/return/momo
MOMO_IPN_URL=http://<HOST>:18080/api/v1/billing/ipn/momo
