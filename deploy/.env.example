# SignLight environment template
# Copy this file to .env and replace every <...> value with a real value.
# Never commit deploy/.env. Never put secret values in NEXT_PUBLIC_* variables.
# Generate secrets locally with:
#   openssl rand -base64 64
#   openssl rand -base64 48
#   openssl rand -hex 32

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
# Local Compose defaults. For Neon/Supabase, set these to the managed database
# values and set SPRING_DATASOURCE_URL to its SSL JDBC URL.
DB_USER=signlight
DB_PASSWORD=<strong-database-password>
DB_NAME=signlight_uat
# For local Compose PostgreSQL:
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/signlight_uat
SPRING_DATASOURCE_USERNAME=signlight
SPRING_DATASOURCE_PASSWORD=<strong-database-password>
# For Neon/Supabase, replace the three values above with the provider's
# host, database, username, password and ?sslmode=require JDBC URL.

# HikariCP: safe defaults for a free PostgreSQL tier.
DB_POOL_MAX_SIZE=4
DB_POOL_MIN_IDLE=1
DB_CONNECTION_TIMEOUT_MS=3000
DB_VALIDATION_TIMEOUT_MS=1000
DB_IDLE_TIMEOUT_MS=600000
DB_MAX_LIFETIME_MS=1800000
# 0 disables diagnostic leak logging. Use 2000 only during troubleshooting.
DB_LEAK_DETECTION_MS=0

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_PASSWORD=<strong-redis-password>
SPRING_DATA_REDIS_HOST=cache
SPRING_DATA_REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Object storage and media
# -----------------------------------------------------------------------------
# Local UAT MinIO credentials. In production, use R2/S3-compatible credentials
# in the provider secret store, not in the frontend.
STORAGE_ACCESS_KEY=<object-storage-access-key>
STORAGE_SECRET_KEY=<object-storage-secret-key>
STORAGE_BUCKET_VIDEO=signlight-video
STORAGE_BUCKET_MEDIA=signlight-media
STORAGE_BUCKET_DONATION=signlight-donation
STORAGE_SIGNED_URL_TTL_SECONDS=900

# R2 public/custom CDN origin for web/<file> objects. Leave empty to use the
# backend stream fallback. Do not use a public URL for paywalled private objects.
R2_PUBLIC_BASE_URL=https://<r2-public-or-cdn-domain>
MEDIA_SIGNING_KEY=<random-media-signing-key>

# -----------------------------------------------------------------------------
# Public URLs
# -----------------------------------------------------------------------------
# These values are used by backend URL generation and frontend build arguments.
# Use HTTPS in deployed environments.
PUBLIC_API_BASE_URL=https://<api-domain>
PUBLIC_WEB_BASE_URL=https://<web-domain>
PUBLIC_CDN_BASE_URL=https://<cdn-domain>

# Internal Docker-only URL. Never expose as NEXT_PUBLIC_*.
INTERNAL_API_BASE_URL=http://api:8080

# Frontend build-time public values. These must not contain secrets.
NEXT_PUBLIC_API_BASE_URL=https://<api-domain>
NEXT_PUBLIC_CDN_BASE_URL=https://<cdn-domain>
NEXT_PUBLIC_APP_URL=https://<web-domain>
NEXT_PUBLIC_MEDIAPIPE_WASM_URL=/wasm/mediapipe
NEXT_PUBLIC_HOLISTIC_MODEL_URL=/models/holistic_landmarker.task

# -----------------------------------------------------------------------------
# Spring application and authentication
# -----------------------------------------------------------------------------
SIGNLIGHT_SEED_ENABLED=false
JWT_SECRET=<random-jwt-secret-at-least-64-characters>
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
IP_HASH_SALT=<random-ip-hash-salt>

# Google OAuth. Leave blank only when OAuth is disabled in the environment.
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>

# -----------------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------------
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<smtp-username>
MAIL_PASSWORD=<smtp-password-or-app-password>
MAIL_FROM=noreply@<your-domain>

# -----------------------------------------------------------------------------
# Spring media paths for local fallback only
# -----------------------------------------------------------------------------
SIGNLIGHT_WEB_VIDEOS_DIR=src/backend/src/main/resources/static/videos/web
SIGNLIGHT_RAW_VIDEOS_DIR=/app/data/raw

# -----------------------------------------------------------------------------
# Internal AI service
# -----------------------------------------------------------------------------
# The AI service has no public authentication and must not have a host port.
SIGNLIGHT_AI_BASE_URL=http://ai:7860
SIGNLIGHT_AI_TIMEOUT_MS=5000
ONNX_INTRA_OP_THREADS=2
SIGNLIGHT_AI_MODEL_VERSION=vsl-mvp30-v2-lite-transformer
SIGNLIGHT_AI_CONFIDENCE_THRESHOLD=0.55
SIGNLIGHT_AI_CONFIDENCE_MARGIN=0.03
SIGNLIGHT_AI_FREE_DAILY_QUOTA=5

# These must remain empty. They disable legacy data-upload integrations.
LOG_WEBHOOK_URL=
LOG_WEBHOOK_SECRET=
GDRIVE_FOLDER_ID=

# -----------------------------------------------------------------------------
# Payment providers
# -----------------------------------------------------------------------------
# Use sandbox endpoints for UAT and production endpoints only in production.
PAYOS_CLIENT_ID=<payos-client-id>
PAYOS_API_KEY=<payos-api-key>
PAYOS_CHECKSUM_KEY=<payos-checksum-key>
PAYOS_ENDPOINT=https://api-merchant.payos.vn
PAYOS_RETURN_URL=https://<web-domain>/thanh-toan/thanh-cong
PAYOS_CANCEL_URL=https://<web-domain>/nang-cap

VNPAY_TMN_CODE=<vnpay-tmn-code>
VNPAY_HASH_SECRET=<vnpay-hash-secret>
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=https://<web-domain>/billing/return/vnpay
VNPAY_IPN_URL=https://<api-domain>/api/v1/billing/ipn/vnpay

MOMO_PARTNER_CODE=<momo-partner-code>
MOMO_ACCESS_KEY=<momo-access-key>
MOMO_SECRET_KEY=<momo-secret-key>
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_RETURN_URL=https://<web-domain>/billing/return/momo
MOMO_IPN_URL=https://<api-domain>/api/v1/billing/ipn/momo

# -----------------------------------------------------------------------------
# Other integrations
# -----------------------------------------------------------------------------
MAIL_PROVIDER_API_KEY=<mail-provider-api-key>
MAIL_FROM_ADDRESS=noreply@<your-domain>
MAIL_FROM_NAME=SignLight
TRANSCODE_WEBHOOK_SECRET=<transcode-webhook-secret>
FINGERSPELL_SUPPORTED_MODEL_VERSIONS=fs-v1.2.0
DONATION_RETENTION_MONTHS=24

# Required only when using the local ngrok Compose service for payment callbacks.
# Do not set this unless ngrok is intentionally enabled.
NGROK_AUTHTOKEN=<ngrok-auth-token>
